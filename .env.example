# --- Backend (backend/.env or root .env — config/env.ts loads both) ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox

REDIS_HOST=localhost
REDIS_PORT=6379

# Any random string; used to sign the session cookie
SESSION_SECRET=change_me_to_a_random_string

# Google Cloud Console > APIs & Services > Credentials > OAuth Client ID (Web application)
# Authorized redirect URI must exactly match GOOGLE_CALLBACK_URL below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# How many BullMQ jobs the worker processes concurrently
WORKER_CONCURRENCY=5

# Optional: reuse a fixed Ethereal test account (https://ethereal.email/create)
# Leave blank to auto-generate a new one on worker startup (logged to console)
ETHEREAL_USER=
ETHEREAL_PASS=

# --- Frontend (frontend/.env) ---
VITE_API_URL=http://localhost:4000
